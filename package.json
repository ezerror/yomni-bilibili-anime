{
  "name": "@yomni/plugin-bilibili-anime",
  "version": "0.2.1",
  "type": "module",
  "description": "Search Bilibili anime and watch episodes inside a Yomni conversation.",
  "license": "MIT",
  "exports": "./dist/index.cjs",
  "files": [
    "yomni-manifest.json",
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "yomni-plugin-build .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "pack": "yomni-plugin pack .",
    "dev": "yomni-plugin-dev .",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@yomni/contracts": "file:vendor/yomni-devkit/yomni-contracts-0.1.0.tgz",
    "@yomni/plugin-build": "file:vendor/yomni-devkit/yomni-plugin-build-0.1.0.tgz",
    "@yomni/plugin-sdk": "file:vendor/yomni-devkit/yomni-plugin-sdk-0.1.0.tgz",
    "@yomni/ui": "file:vendor/yomni-devkit/yomni-ui-0.1.0.tgz",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2"
  },
  "yomni": {
    "id": "yomni.bilibili-anime",
    "apiVersion": 1,
    "runtime": "node",
    "manifest": "./yomni-manifest.json"
  }
}
