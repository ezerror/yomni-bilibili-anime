{
  "name": "@pal-plugin/bilibili-anime",
  "version": "0.2.0",
  "type": "module",
  "description": "Search Bilibili anime and watch episodes inside a PAL conversation.",
  "license": "MIT",
  "exports": "./dist/index.cjs",
  "files": [
    "pal-manifest.json",
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "pal-plugin-build .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "pack": "pal-plugin pack .",
    "dev": "pal-plugin-dev .",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@anypal/contracts": "file:vendor/current/anypal-contracts-0.1.0.tgz",
    "@anypal/plugin-build": "file:vendor/current/anypal-plugin-build-0.1.0.tgz",
    "@anypal/plugin-sdk": "file:vendor/current/anypal-plugin-sdk-0.1.0.tgz",
    "@anypal/ui": "file:vendor/current/anypal-ui-0.1.0.tgz",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2"
  },
  "pal": {
    "id": "pal.bilibili-anime",
    "apiVersion": 1,
    "runtime": "node",
    "manifest": "./pal-manifest.json"
  }
}
