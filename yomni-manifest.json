  "tools": [
    {
      "id": "bilibili_search_anime",
      "title": "Search Bilibili anime",
      "description": "Search Bilibili anime and create an interactive player in this conversation. Include the returned directive verbatim on its own line in your reply, outside code fences. The player supports season and episode switching without another model call.",
      "requiredPermissions": [
        "yomni.network.fetch",
        "yomni.storage.read",
        "yomni.storage.write"
      ],
      "workspaceEffects": "none",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyword"
        ],
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "max_seasons": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "default": 5
          }
        }
      },
      "locales": {
        "zh-CN": {
          "title": "搜索哔哩哔哩番剧"
        }
      }
    }
  ],
  "promptSections": [
    {
      "id": "bilibili-player",
      "description": "Show the interactive anime player",
      "mode": "static",
      "when": {
        "anyToolAvailable": [
          "bilibili_search_anime"
        ]
      },
      "text": "When the user requests anime on Bilibili, call bilibili_search_anime. The tool stores its result as a plugin-owned player. Copy its directive exactly on a standalone line in your reply, outside code fences. The directive starts with :::yomni:bilibili-anime followed by a space and the returned JSON object; preserve this entire visible prefix. Do not reconstruct the player in Markdown or repeat the episode list. Clicking seasons or episodes is handled directly by the plugin. Playback is provided by Bilibili's official player."
    }
  ],
  "provides": {
    "yomni.bilibili-anime.agent-support.prompts": {
      "contract": "yomni.agent-support.prompt-provider",
      "apiVersion": 1
    },
    "yomni.bilibili-anime.tools": {
      "contract": "yomni.tools.provider",
      "apiVersion": 1,
      "transport": "reference"
    }
  },
  "contributions": [
    "services"
  ],
  "consumes": {
    "toolAuthorizations": {
      "contract": "yomni.tools.authorizations",
      "apiVersion": 1,
      "transport": "reference",
      "optional": true,
      "autoBind": true,
      "bindingMode": "dynamic"
    }
  },
  "optionalPermissions": [
    "yomni.agent-support.read"
  ]
}
